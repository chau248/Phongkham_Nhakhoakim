<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nhakhoakim.ui.XoaLichHenController"
      spacing="10.0" prefWidth="430.0"
      style="-fx-background-color: white; -fx-font-family: 'Segoe UI';">
    <padding><Insets top="10.0" right="8.0" bottom="4.0" left="8.0"/></padding>
    <Label text="Bạn có chắc chắn muốn hủy lịch hẹn này? Hành động này sẽ không hoàn tác."
           wrapText="true"/>
    <Label fx:id="lblThongTinLich" wrapText="true"
           style="-fx-border-color: #444444; -fx-padding: 8;"/>
    <Label text="Nhập lý do hủy (bắt buộc, ít nhất 10 ký tự):"
           style="-fx-font-weight: bold;"/>
    <TextArea fx:id="txtLyDo" promptText="Nhập lý do hủy" prefRowCount="3" wrapText="true"/>
</VBox>
