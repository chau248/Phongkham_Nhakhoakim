<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" prefWidth="580.0"
      style="-fx-background-color: white; -fx-font-family: 'Segoe UI';"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nhakhoakim.ui.CapNhatHoSoBenhNhanController">
    <padding>
        <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
    </padding>
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="150.0" prefWidth="160.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Mã bệnh nhân" GridPane.rowIndex="0"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtMaBN" editable="false" focusTraversable="false"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Họ tên (*)" GridPane.rowIndex="1"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtHoTen" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Ngày sinh" GridPane.rowIndex="2"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <DatePicker fx:id="dpNgaySinh" maxWidth="Infinity"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Giới tính" GridPane.rowIndex="3"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <ComboBox fx:id="cmbGioiTinh" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Số điện thoại" GridPane.rowIndex="4"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtSdt" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Số căn cước (CCCD)" GridPane.rowIndex="5"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtSoCCCD" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label text="Email" GridPane.rowIndex="6"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label text="Địa chỉ" GridPane.rowIndex="7"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtDiaChi" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        <Label text="Người liên hệ khẩn cấp" GridPane.rowIndex="8"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtNguoiLienHe" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
        <Label text="SĐT người liên hệ" GridPane.rowIndex="9"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtSdtNguoiLienHe" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
        <Label text="Ghi chú" GridPane.rowIndex="10"
               style="-fx-font-weight: bold; -fx-text-fill: #6B7C8A;"/>
        <TextField fx:id="txtGhiChu" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
    </GridPane>
</VBox>